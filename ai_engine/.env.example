# -----------------------------------------------------------------------
# .env.example
# Copy this file to .env for local development.
# NEVER commit .env to version control.
# -----------------------------------------------------------------------

# SQL Server connection string (required).
# Format: mssql+pyodbc://user:password@host/database?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no
# The driver name must match exactly what is installed on the system.
DATABASE_URL=mssql+pyodbc://db41636:W%40c9%3D7ZqT%3Fn4@db41636.public.databaseasp.net/db41636?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no

# Root directory where trained Prophet models are stored.
# On Render: point this to a persistent disk mount (e.g. /data/models).
# Locally: any writable path works.
MODEL_ROOT=/opt/models

# Port the server listens on.
# Render injects this automatically — do not set it in the Render dashboard.
PORT=8000
